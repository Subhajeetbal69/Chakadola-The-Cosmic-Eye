# ──────────────────────────────────────────────
# Chakadola — The Cosmic Eye — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── Required: Gemini AI (Conjunction AI Assessment) ──
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# ── Required: Public URL of the deployed app ──
# Set to your Render URL after deployment: https://chakadola-the-cosmic-eye.onrender.com
APP_URL="https://chakadola-the-cosmic-eye.onrender.com"

# ── Required: PostgreSQL Database (Production) ──
# Supabase format: postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres
# Leave empty to use SQLite local fallback instead.
DATABASE_URL="postgresql://user:password@host:6543/postgres"

# ── Optional: Space-Track.org (Tier 3 data source, 3500+ objects) ──
# Register free at: https://www.space-track.org/auth/createAccount
SPACETRACK_USER=""
SPACETRACK_PASSWORD=""

# ── Runtime: Set by hosting platform (Render/Railway auto-inject) ──
NODE_ENV="production"
PORT="3000"
